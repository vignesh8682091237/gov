# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file.

# --- Flask ---
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-value
JWT_SECRET_KEY=change-me-to-a-different-long-random-value
JWT_ACCESS_MINUTES=60

# --- Database (used directly by the backend) ---
DATABASE_URL=postgresql+psycopg2://consent_app:change-me@localhost:5432/consent_analytics

# --- Database (used by docker-compose to create the Postgres container) ---
POSTGRES_USER=consent_app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=consent_analytics

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Privacy / retention ---
MASK_IPS_IN_DASHBOARD=true
DATA_RETENTION_DAYS=180

# --- Security ---
FORCE_HTTPS=false

# --- Frontend build-time API base URL ---
VITE_API_BASE_URL=http://localhost:5000
